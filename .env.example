DATABASE_URL=postgresql+asyncpg://escrow:escrow@db:5432/escrow
# Production example:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/escrow

ESCROW_API_KEY=replace-with-long-random-platform-key
ADMIN_API_KEY=replace-with-long-random-admin-key

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=https://your-public-domain.example
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_CERTIFICATE_PATH=/run/secrets/mpesa/SafaricomCertificate.cer
MPESA_CALLBACK_SECRET=replace-with-long-random-callback-token
# Must match how MPESA_SHORTCODE is registered with Safaricom:
# "CustomerPayBillOnline" for a PayBill number, "CustomerBuyGoodsOnline" for
# a Till Number. Getting this wrong does not fail loudly at request time.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Refunds inside this window after the original STK/C2B receipt use the
# Reversal API instead of a fresh B2C payment (cheaper, faster, reconciles
# against the original receipt).
MPESA_REVERSAL_WINDOW_HOURS=24

# Alert threshold for the B2C working-account float (see
# /admin/mpesa/account-balance/check and the balance-callback handler).
FLOAT_LOW_BALANCE_THRESHOLD=10000

# Scheduled (automated, no admin action needed) reconciliation: checks the
# B2C float and queries Transaction Status for any payout stuck INITIATED
# with no callback for longer than the staleness window below.
RECONCILIATION_INTERVAL_SECONDS=21600
PAYOUT_STALE_INITIATED_MINUTES=30

# How many total attempts (including the background dead-letter retry
# sweep, not just send_sms's own internal retries) before a failed
# notification is treated as permanently dead and alerted as such.
NOTIFICATION_MAX_TOTAL_ATTEMPTS=10

# Buyer web/app URL used in the post-payment SMS to display the delivery QR.
BUYER_PORTAL_BASE_URL=https://buyer.example.com

# Development only. Set false in production and run Alembic migrations first.
DB_AUTO_CREATE=true

QR_EXPIRY_CHECK_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMS provider. Set to "africastalking" for a real Africa's Talking
# integration (recommended for a Kenya-market/Safaricom-adjacent deployment),
# or "generic" to use the NOTIFICATION_PROVIDER_URL webhook below. Leave
# blank only for local development (messages are logged to console).
SMS_PROVIDER=africastalking
# Bounded retry for transient (network/timeout) SMS send failures. A
# confirmed provider rejection (invalid number, blacklisted, etc.) is never
# retried regardless of this setting.
SMS_MAX_ATTEMPTS=3
SMS_RETRY_BACKOFF_SECONDS=1

# Africa's Talking (used when SMS_PROVIDER=africastalking)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional registered shortcode/alphanumeric sender ID. Leave blank to use
# Africa's Talking's shared/default sender.
AFRICASTALKING_SENDER_ID=
# "sandbox" while testing against Africa's Talking's sandbox app, "production" to go live.
AFRICASTALKING_ENV=sandbox

# Optional generic SMS webhook (used when SMS_PROVIDER=generic). Not needed
# when using Africa's Talking above.
NOTIFICATION_PROVIDER_URL=
NOTIFICATION_PROVIDER_TOKEN=

# Optional secret for your approved USSD gateway/provider callback. Sent as
# the X-Ussd-Secret header (like the M-Pesa callback secret), not a URL
# query parameter, so it never lands in access/proxy logs.
USSD_CALLBACK_SECRET=
# How long a USSD session can sit idle before it's treated as abandoned and
# restarted at the main menu, rather than resuming stale state.
USSD_SESSION_TTL_SECONDS=180

# Optional ops alert webhook (e.g. a Slack Incoming Webhook URL). Fires when
# a payout ends up FAILED or TIMEOUT and needs human attention. If blank,
# these are only logged.
OPS_ALERT_WEBHOOK_URL=
